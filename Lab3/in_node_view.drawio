<mxfile host="app.diagrams.net"><diagram name="In-node view" id="innode"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="960" pageHeight="680" background="#111111" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="&lt;b&gt;Base Station&lt;/b&gt;&lt;br&gt;Rank 9 (single process)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff6a00;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="8" width="240" height="52" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Neighbour nodes&lt;/b&gt;&lt;br&gt;ranks 1, 3, 5, 7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6a8a5e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="160" width="150" height="100" as="geometry"/></mxCell><mxCell id="5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2d2d2d;strokeColor=#888888;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="640" height="495" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Charging node: rank 4 = one MPI process&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#ffffff;fontSize=13;spacing=0;" vertex="1" parent="1"><mxGeometry x="312" y="108" width="300" height="22" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Master thread (omp master): the only thread that calls MPI&lt;/b&gt;&lt;br&gt;1. Count the free ports in ports[K]&lt;br&gt;2. If free &amp;lt; threshold: send STATUS_REQUEST to every neighbour, collect replies&lt;br&gt;3. A neighbour has enough free ports?  Redirect the EVs to it&lt;br&gt;4. Otherwise send a REPORT to the base station and wait for its RESPONSE&lt;br&gt;5. Always keep answering neighbours&amp;#x27; requests; stop when TERMINATE arrives" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6a8a5e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="132" width="580" height="146" as="geometry"/></mxCell><mxCell id="8" value="omp barrier: every port has updated before the count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8a4a4a;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="308" width="580" height="24" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;ports[0]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8962e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="356" width="85" height="44" as="geometry"/></mxCell><mxCell id="10" value="Port thread 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="466" width="85" height="50" as="geometry"/></mxCell><mxCell id="11" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="466" as="sourcePoint"/><mxPoint x="372" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="356" as="sourcePoint"/><mxPoint x="372" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="&lt;b&gt;ports[1]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8962e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="429" y="356" width="85" height="44" as="geometry"/></mxCell><mxCell id="14" value="Port thread 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="429" y="466" width="85" height="50" as="geometry"/></mxCell><mxCell id="15" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="466" as="sourcePoint"/><mxPoint x="471" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="16" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="356" as="sourcePoint"/><mxPoint x="471" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="&lt;b&gt;ports[2]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8962e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="528" y="356" width="85" height="44" as="geometry"/></mxCell><mxCell id="18" value="Port thread 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="528" y="466" width="85" height="50" as="geometry"/></mxCell><mxCell id="19" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="466" as="sourcePoint"/><mxPoint x="570" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="356" as="sourcePoint"/><mxPoint x="570" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="&lt;b&gt;ports[3]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8962e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="627" y="356" width="85" height="44" as="geometry"/></mxCell><mxCell id="22" value="Port thread 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="627" y="466" width="85" height="50" as="geometry"/></mxCell><mxCell id="23" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="669" y="466" as="sourcePoint"/><mxPoint x="669" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="669" y="356" as="sourcePoint"/><mxPoint x="669" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="&lt;b&gt;ports[4]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8962e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="726" y="356" width="85" height="44" as="geometry"/></mxCell><mxCell id="26" value="Port thread 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="726" y="466" width="85" height="50" as="geometry"/></mxCell><mxCell id="27" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768" y="466" as="sourcePoint"/><mxPoint x="768" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768" y="356" as="sourcePoint"/><mxPoint x="768" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="&lt;b&gt;ports[5]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8962e;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="356" width="85" height="44" as="geometry"/></mxCell><mxCell id="30" value="Port thread 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="466" width="85" height="50" as="geometry"/></mxCell><mxCell id="31" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="867" y="466" as="sourcePoint"/><mxPoint x="867" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="867" y="356" as="sourcePoint"/><mxPoint x="867" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="308" as="sourcePoint"/><mxPoint x="620" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="Ports are OpenMP threads, not processes. Each cycle every port thread sets its own&lt;br&gt;slot of the shared ports[K] array (K = 6): 1 = busy, 0 = free." style="text;html=1;align=left;verticalAlign=top;fontColor=#ffffff;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="533" width="300" height="38" as="geometry"/></mxCell><mxCell id="35" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;startArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="60" as="sourcePoint"/><mxPoint x="820" y="132" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="REPORT (NodeReport) to base&lt;br&gt;RESPONSE, TERMINATE from base" style="text;html=1;align=right;verticalAlign=top;fontColor=#ffffff;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="68" width="300" height="36" as="geometry"/></mxCell><mxCell id="37" value="" style="endArrow=classic;html=1;strokeColor=#ffffff;strokeWidth=1.5;startArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="210" as="sourcePoint"/><mxPoint x="330" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="STATUS_REQUEST /&lt;br&gt;STATUS_REPLY" style="text;html=1;align=left;verticalAlign=top;fontColor=#ffffff;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="177" width="300" height="36" as="geometry"/></mxCell><mxCell id="39" value="Ports are not separate processes: they are OpenMP threads updating a shared array inside the node process." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4f6173;strokeColor=#d0d0d0;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="612" width="930" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>